# =============================================================================
# AI Candidate Avatar - Environment Variables
# =============================================================================

# 1. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Supabase Configuration (Free Tier: https://supabase.com)
# Obtain from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key is required on server-side for HR unauthenticated session creation & admin tasks
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Google Gemini API (Free Tier: https://aistudio.google.com)
# Used for LLM inference and text embeddings (@google/genai SDK)
GEMINI_API_KEY=AIzaSy...
# Configurable model names - if Google updates/rotates models, update these variables without code changes:
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# 4. Upstash Redis Rate Limiting (Free Tier: https://upstash.com)
# Used for sliding window rate limiting (session message cap & daily avatar query cap)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# 5. Resend Email Delivery (Free Tier: https://resend.com)
# Used to email post-interview scorecard and transcript PDF to recruiter and candidate
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev
